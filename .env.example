# API root before /apirest.php. HTTP is supported only when explicitly enabled.
GLPI_BASE_URL=https://glpi.example.internal/glpi
GLPI_APP_TOKEN=
GLPI_ALLOW_HTTP=false
GLPI_TIMEOUT_MS=10000

# disabled | solution | status-solved | status-closed
GLPI_CLOSE_STRATEGY=status-closed

REDIS_URL=redis://redis:6379
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
# Se pueden autorizar varios origenes exactos separados por comas.
APP_ORIGIN=https://incidencias.example.internal
